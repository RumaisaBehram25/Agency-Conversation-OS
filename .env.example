# ===========================================
# Attora MVP — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://attora:Attora-123@attora-db.cp8ooqrtonyo.us-east-1.rds.amazonaws.com:5432/attora
DATABASE_URL_SYNC=postgresql://attora:Attora-123@attora-db.cp8ooqrtonyo.us-east-1.rds.amazonaws.com:5432/attora
POSTGRES_USER=attora
POSTGRES_PASSWORD=Attora-123
POSTGRES_DB=attora

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# AI / Anthropic (REQUIRED for AI engine)
ANTHROPIC_API_KEY=sk-ant-REDACTED-PLACEHOLDER

# External APIs
# SENTRY_DSN=https://...

# App Settings
APP_NAME=Attora
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# OLAP / Data Lake
OLAP_STORAGE_PROVIDER=none
OLAP_QUERY_PROVIDER=none
OLAP_BUCKET=attora-analytics
OLAP_PREFIX=lake
OLAP_REGION=us-east-1
OLAP_ENDPOINT=
OLAP_ACCESS_KEY_ID=
OLAP_SECRET_ACCESS_KEY=
OLAP_S3_FORCE_PATH_STYLE=true
OLAP_SECURE=false
OLAP_EXPORT_BATCH_SIZE=5000
OLAP_MESSAGE_HOT_RETENTION_DAYS=90
OLAP_DELTA_WINDOW_DAYS=7
OLAP_CHECKPOINT_PREFIX=_control/checkpoints

# Self-hosted Trino
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_HOST_PORT=8083
TRINO_USER=attora
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=default
TRINO_HTTP_SCHEME=http

# AWS Athena
ATHENA_WORKGROUP=primary
ATHENA_DATABASE=attora_analytics
ATHENA_OUTPUT_LOCATION=

# OLAP Scheduler
OLAP_SCHEDULER_ENABLED=false
OLAP_SCHEDULER_TIMEZONE=UTC
OLAP_SCHEDULER_EXPORT_DAILY_ANALYTICS_CRON="5 1 * * *"
OLAP_SCHEDULER_EXPORT_AI_USAGE_CRON="20 1 * * *"
OLAP_SCHEDULER_ARCHIVE_MESSAGES_CRON="35 1 * * *"
OLAP_SCHEDULER_PARITY_CRON="50 1 * * *"
OLAP_SCHEDULER_PARITY_ORG_IDS=

# Hyros purchase sync (self-hosted scheduler uses OLAP_SCHEDULER_TIMEZONE for cron TZ)
# Docker: `docker compose --profile hyros-scheduler up hyros-scheduler` (no OLAP stack)
HYROS_SYNC_SCHEDULER_ENABLED=false
HYROS_SYNC_SCHEDULER_CRON="0 */3 * * *"

# Follow-up dispatcher (sends silent-lead nudges via ManyChat outbound flow)
# Requires Organization.manychat_outbound_flow_ns to be set per org.
# Recommended cadence: every 15 minutes.
FOLLOW_UP_SCHEDULER_ENABLED=false
FOLLOW_UP_SCHEDULER_CRON="*/15 * * * *"

CRON_SECRET=test-secret-123
